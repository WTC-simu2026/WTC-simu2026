    "mesh_element_counts": [1,2,8,32],
    "cross_section_element_counts": {"y":2,"z":2},
    "boundary_conditions": "x=0 face fixed in U1; y=0 symmetry plane fixed in U2; z=0 symmetry plane fixed in U3; x=L face receives uniform U1 history; transverse contraction remains free elsewhere",
